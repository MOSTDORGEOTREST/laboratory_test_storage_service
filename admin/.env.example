# Скопировать в admin/.env и заполнить. Файл .env в git не коммитить!

# Админка
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # придумать сильный пароль
ADMIN_JWT_SECRET=          # openssl rand -hex 32

# Домен лабораторий: лабы будут на <имя>.<DOMAIN>, админка на admin.<DOMAIN>
DOMAIN=lts.example.com
ACME_EMAIL=admin@example.com

# Образ основного приложения (docker build -t lts:latest ./src)
LTS_IMAGE=lts:latest

# Общий Postgres-кластер
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=         # сильный пароль кластера

# Общий S3 (у каждой лабы будет свой префикс ключей <имя>/)
AWS_URI=
AWS_ACCCESS_KEY=
AWS_SERVICE_NAME=s3
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET=
